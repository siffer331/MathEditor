cabal-version:      3.0
--   http://haskell.org/cabal/users-guide/

-- Temp name
name:               Mat
-- description:
version:            0.1.0.0
synopsis:           Type theory based math editor inteded for univalent foundations.
license:            BSD-3-Clause
license-file:       LICENSE
build-type:         Simple

common warnings
    ghc-options: -Wall

executable Mat
    import:           warnings

    main-is:          Main.hs

    other-modules:
        TypeTheory
      , TypeTheoryExamples
      , UI
      , UIData
      , Util
      , Colors

    build-depends:
        base ^>=4.20.2.0
      , monomer
      , lens
      , data-default
      , text
      , text-show

    hs-source-dirs:   src

    default-language: Haskell2010
